{
  "name": "selenium-nodejs-request-mocks",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--require ./src/patch-fetch.js' next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test test/no-mocks.spec.js",
    "test:client-mocks": "node --test test/client-mocks.spec.js",
    "test:server-mocks": "node --disable-warning=MaxListenersExceededWarning --test test/server-mocks.spec.js",
    "test:all": "npm run test && npm run test:client-mocks && npm run test:server-mocks"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/selenium-webdriver": "^4.35.5",
    "prettier": "^3.8.3",
    "request-mocking-protocol": "^0.2.0",
    "selenium-webdriver": "^4.43.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@types/react": "19.2.14"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true
  }
}
